# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- Model provider (required) -------------------------------------------
# The only secret this app needs today.
TOKENROUTER_API_KEY=sk-your-key-here

# Optional overrides — the defaults match the values below.
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
# DEFAULT_MODEL=moonshotai/kimi-k3-free

# ---- Runtime -------------------------------------------------------------
# ENVIRONMENT=local          # local | production ("local" enables /docs)
# DEBUG=false                # true adds exception detail to error responses
# LOG_LEVEL=INFO
# HOST=127.0.0.1
# PORT=8787

# ---- Database ------------------------------------------------------------
# Defaults to SQLite at ./data/kimi.db. For PostgreSQL install the extra
# (`uv sync --extra postgres`) and use the asyncpg driver:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/kimi

# ---- CORS ----------------------------------------------------------------
# Comma-separated or a JSON list.
# CORS_ORIGINS=http://localhost:3000

# ---- Frontend ------------------------------------------------------------
# Read at build time by Next.js; only set if the API is not on the default.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
